APP_NAME=LedgerKit
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_DB_URL=postgresql+psycopg://ledgerkit:ledgerkit@localhost:5432/ledgerkit
APP_DB_MIGRATION_URL=
APP_DB_POOL_SIZE=5
APP_DB_MAX_OVERFLOW=10
APP_DB_CONNECT_TIMEOUT_SECONDS=5
APP_HEALTH_DB_TIMEOUT_MS=2000
# APP_DEFAULT_TENANT_ID=<printed by make seed>
APP_SUPPORTED_CURRENCIES=["INR","USD","EUR","GBP","SGD"]
